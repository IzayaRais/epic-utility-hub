# EPIC Utility Hub - environment configuration
# Copy to .env for local development. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# REQUIRED: session signing secret
# Sessions are stateless signed cookies, so every instance must share this.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Missing in production => the server refuses to start.
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# REQUIRED: access codes
# One per facility. An operator signs in with their facility + code and can
# then only read and write that facility's registers.
# ---------------------------------------------------------------------------
PLANT_CODE_CIPL=
PLANT_CODE_EGMCL_1=
PLANT_CODE_EGMCL_2=
PLANT_CODE_EGMCL_7=
PLANT_CODE_PGCL=
PLANT_CODE_GTL=

# Central Engineering code: opens every facility, plus the audit CSV export,
# the diagnostics modal and the cache flush.
ADMIN_CODE=

# ---------------------------------------------------------------------------
# Google Sheets access (one of these)
# ---------------------------------------------------------------------------
# Production (Vercel): paste the whole service-account JSON on one line.
# GOOGLE_CREDENTIALS={"type":"service_account",...}
#
# Or split out:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
#
# Local development falls back to ./credentials.json when neither is set.

SPREADSHEET_ID=1dfY5fkCvrgFTkGxH8ozSUhmct7q5oL6gCSWnpwUV7LY

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# Redis/Upstash. Without it the server uses a bounded in-memory cache, which on
# serverless mostly misses because each invocation may be a fresh process.
# REDIS_URL=

# Only set if a different origin must call this API. Default is same-origin.
# ALLOWED_ORIGIN=https://your-app.vercel.app

# PORT=3000
